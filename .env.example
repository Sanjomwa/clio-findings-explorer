# Local development settings. Copy to .env: `cp .env.example .env`.
# These are local-only placeholder values for a throwaway Postgres container,
# not secrets. No cloud, BigQuery or deploy credentials ever go in this file;
# deploy credentials live in GitHub Actions only.

POSTGRES_USER=clio
POSTGRES_PASSWORD=clio-local-only
POSTGRES_DB=clio_findings

# Grafana (the lgtm service, http://127.0.0.1:3000): the admin password. Viewing needs no login.
# A local-only placeholder, like the values above.
GF_ADMIN_PASSWORD=change-me-local-only
