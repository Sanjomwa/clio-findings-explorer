# No client IPs: the format has no $remote_addr, and $uri leaves out the query string.
log_format no_ip '$time_iso8601 $request_method $uri $status $body_bytes_sent $request_time';

server {
    listen 8080;
    access_log /dev/stdout no_ip;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Works for http://backend:8000 (compose) and an https://...run.app backend.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
    }

    # Hashed build files never change under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
